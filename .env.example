# Salin ke .env untuk jalan lokal, atau isi di Coolify (Environment Variables).

# Wajib: password untuk masuk ke panel admin.
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Alamat publik aplikasi (dipakai untuk link di pesan WhatsApp). Tanpa garis miring di akhir.
BASE_URL=https://guesthouse.lewat.web.id

# Opsional: alamat panel admin (default /admin).
# ADMIN_PATH=/atur

# Opsional: kunci penanda sesi login. Jika kosong, diturunkan dari ADMIN_PASSWORD.
# SESSION_SECRET=

# Pengiriman WhatsApp otomatis: fonnte | waha | none (default none)
WA_PROVIDER=none

# Jika WA_PROVIDER=fonnte
# FONNTE_TOKEN=

# Jika WA_PROVIDER=waha
# WAHA_URL=http://waha:3000
# WAHA_API_KEY=
# WAHA_SESSION=default

# Folder database SQLite (di Docker sudah diatur ke /data).
# DATA_DIR=./data
# PORT=3000
